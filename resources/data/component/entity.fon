player {
	EntityComponent {
		type Player
	}
	DirectionComponent {
	}
	SmoothMovementComponent {
		acc 32
		dec 40
		spd 15
	}
	BodyComponent {
		type Dynamic
		fixedRotation true
		shape Circle
		radius 0.5
	}
	SpriteComponent {
		texture gfx/entity/player.png
		targetSize [1.0 1.0]
		layer Player
	}
}
bullet {
	EntityComponent {
		type PlayerProj
	}
	BodyComponent {
		type Dynamic
		fixedRotation false
		shape Box
		size [0.4 0.2]
		density 0.3
		friction 0.0
		restitution 1.0
	}
	ProjectileComponent {
		impulse 10
		damage 6
		pierce 1
	}
	SpriteComponent {
		texture gfx/entity/bullet.png
		followRotation true
		targetSize [1 1]
		layer PlayerProj
	}
}
