bullet_spell.title "子弹"
bullet_spell.description "发射一枚子弹。"
bullet_spell.flavor "[rgb(0,0,180)][i]这应该也是魔法[/][/]"
add_explosion_spell.title "爆炸附加"
add_explosion_spell.description "法术命中时，生成一个爆炸。"
add_explosion_spell.flavor "[rgb(0,0,180)][i]不觉得很酷吗[/][/]"
multi_shots.title "多重射击"
